{
  "info": {
    "name": "Mini Forum",
    "description": "Run Accounts, then Forum. Choose Owner cleanup or Admin cleanup for that run's records. For a new run, set a fresh demo_suffix or skip registration and reuse the existing accounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Register user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mini_forum_demo_a_{{demo_suffix}}\",\n  \"password\": \"{{password_user_a}}\",\n  \"email\": \"mini-forum-a-{{demo_suffix}}@example.com\",\n  \"repeated_password\": \"{{password_user_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response omits passwords\", function () {",
                  "    const account = pm.response.json();",
                  "    pm.expect(account).to.not.have.property(\"password\");",
                  "    pm.expect(account).to.not.have.property(\"repeated_password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mini_forum_demo_a_{{demo_suffix}}\",\n  \"password\": \"{{password_user_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const value = pm.response.json().token;",
                  "    pm.test(\"Response has a valid token\", function () {",
                  "        pm.expect(value).to.be.a(\"string\").and.not.be.empty;",
                  "    });",
                  "    pm.collectionVariables.set(\"token_user_a\", value);",
                  "}"
                ]
              }
            }
          ]
        },
